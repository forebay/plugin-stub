{
  "name": "plugin-stub",
  "version": "2.0.0",
  "description": "The smallest real weivel plugin: one service, one action and two settings, kept as a template another plugin starts from.",
  "main": "dist/plugin.js",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forebay/plugin-stub.git"
  },
  "keywords": [
    "plugin",
    "stub",
    "weivel",
    "forebay",
    "example",
    "template"
  ],
  "files": [
    "dist/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
