{
  "api": 1,
  "importName": "plugin-stub",
  "id": "plugin-stub",
  "version": "2.0.0",
  "entry": "dist/plugin.js",
  "bundle": {
    "entry": "src/plugin.ts"
  },
  "displayName": "Stub Plugin",
  "services": {
    "provides": ["plugin-stub:actions"],
    "consumes": ["weivel.config", "weivel.log"]
  },
  "actions": {
    "greet": {
      "label": "Say the greeting",
      "call": {
        "service": "plugin-stub:actions",
        "method": "greet"
      }
    }
  },
  "config": {
    "defaults": {
      "logging": true,
      "greeting": "hello"
    }
  },
  "repo": {
    "role": "Reference plugin and starting point",
    "category": "plugin",
    "tech": ["typescript"]
  }
}
